# Required to enable the portfolio chat. Keep the real value in .env.
OPENAI_API_KEY=

# Optional; defaults to gpt-4.1-mini when omitted.
OPENAI_MODEL=gpt-4.1-mini

# Optional; the model that grades answers in `pnpm eval`.
# Defaults to gpt-5.6-terra. Uses OPENAI_API_KEY above.
EVAL_JUDGE_MODEL=gpt-5.6-terra
